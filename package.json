{
  "name": "@scm-js/replay",
  "version": "1.0.0",
  "description": "Read StarCraft: Brood War replays (.rep), from 1.16 to Remastered, in Node.js and the browser: header, players, every command, and the map",
  "keywords": ["starcraft", "brood war", "remastered", "replay", "rep", "screp", "bwapi", "parser"],
  "homepage": "https://github.com/scm-js/replay#readme",
  "bugs": { "url": "https://github.com/scm-js/replay/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/scm-js/replay.git" },
  "license": "MIT",
  "author": "scmJS (https://github.com/scm-js)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./write": {
      "import": { "types": "./dist/write.d.mts", "default": "./dist/write.mjs" },
      "require": { "types": "./dist/write.d.cts", "default": "./dist/write.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:publish": "publint --strict",
    "check:exports": "attw --pack . --profile node16",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:publish && npm run check:exports",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "mopaq": "^1.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.6",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": { "node": ">=18.0.0" },
  "publishConfig": { "access": "public" }
}
